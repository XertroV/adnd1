{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Append-only citation evidence seals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactType",
    "seals"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactType": {
      "const": "append-only-citation-evidence-seals"
    },
    "seals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "sizeBytes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?:research\\/|tests\\/fixtures\\/)(?!\\.{1,2}(?:\\/|$))[^/\\\\\\x00]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\\\\\x00]+)*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    }
  }
}
