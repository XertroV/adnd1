  "sourceObservation": {
    "assumptions": "All times assume the sage can conduct research and obtain necessary equipment within a day or two after discovering the need; the costs shown assume these activities.",
    "locationAlternative": {
      "scope": "Shared note for the four information-discovery rows when no town or city is nearby.",
      "alternatives": [
        "Double times and costs.",
        "Compute the sojourn expenditure necessary to reach a locale where the needed materials are available, and determine other expenses as well."
      ],
      "doNotInfer": "The source presents alternatives. Do not encode a universal or unconditional 2x multiplier."
    },
    "noCostRules": [
      {
        "scopeRecordIds": [
          "dmg-info-discovery-row-01",
          "dmg-info-discovery-row-02",
          "dmg-info-discovery-row-03"
        ],
        "scope": "Out of fields, minor field, and major field rows.",
        "condition": "If the percentile dice score for knowing the answer falls in the lower 20% of the spread, no costs are incurred because the material is on hand."
      },
      {
        "scopeRecordIds": [
          "dmg-info-discovery-row-04"
        ],
        "scope": "Special category of study only.",
        "condition": "Any spread within the lower 80% has no cost."
      }
    ],
    "workedExample": {
      "status": "source illustration; retain as illustration, not a general threshold rule",
      "text": "The source example gives a 31%-to-40% chance of knowing a question; if the dice indicate a 32% chance, a following roll of 32% or less indicates knowledge, while a roll of 06% or less indicates the sage already has the information and incurs no additional expense."
    },
    "rightColumnContinuation": "The sage accumulates materials in this area. The DM judges whether a closely related later query can be answered from the same previously obtained materials. Some costs are payments, fees, or bribes rather than materials.",
    "adjacentSeparateParagraph": "The following paragraph separately allows the DM to extend time for unusually difficult specific or exacting questions. It is not part of the left Note/right-column continuation and remains outside this finding unless root adjudicates otherwise."
  },
